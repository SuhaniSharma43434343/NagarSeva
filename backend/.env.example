# ===========================================
# NagarSeva Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Cloudinary (Image Upload Service) ---
cloudinary_cloud_name="your_cloud_name"
cloudinary_api_key="your_api_key"
cloudinary_api_secret="your_api_secret"

# --- AI/ML Microservice (Local Pothole Detection) ---
MODEL_SERVICE_URL="http://localhost:7860"

# --- Database ---
# Prisma supports PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, and CockroachDB
# See: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://username:suhani4343@localhost:5432/NagarSeva?schema=public"

# --- Authentication ---
JWT_SECRET="your_jwt_secret_here"
